{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "composite": false,
    "types": [
      "node",
      "vite/client"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "target": "ES2022",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ]
    }
  },
  "include": [
    "src/runtime/**/*.ts",
    "src/shared/runtime/**/*.ts",
    "src/preload/index.d.ts",
    "tests/runtime/**/*.ts",
    "tests/electron/**/*.ts",
    "vitest.config.ts"
  ]
}
